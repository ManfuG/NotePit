{
  "name": "notepit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:pdf": "node scripts/setup-pdf.mjs",
    "predev": "npm run setup:pdf",
    "prebuild": "npm run setup:pdf",
    "dev": "vite --host 127.0.0.1",
