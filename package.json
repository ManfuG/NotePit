{
  "name": "notepit",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "setup:pdf": "node scripts/setup-pdf.mjs",
    "notices": "node scripts/notices.mjs",
    "predev": "npm run setup:pdf",
    "prebuild": "npm run setup:pdf && npm run notices",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/*.test.mjs",
    "android:build": "npm run build && node scripts/android-build.mjs debug",
    "android:test": "node scripts/android-build.mjs test",
    "android:release": "npm run build && node scripts/android-build.mjs release"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mdit/plugin-katex": "^1.1.4",
    "codemirror": "6.0.2",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
