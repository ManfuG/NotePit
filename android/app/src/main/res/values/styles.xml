<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3157D5</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAFAFF</item>
    </style>
    <style name="AppTheme.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#11141F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_notepit</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
